<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainActivityTheme" parent="Theme.PLAcreator">
        <!-- Autres attributs de style personnalisés ici -->
        <item name="android:colorButtonNormal">@color/white</item>
        <item name="android:buttonCornerRadius">10dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:elevation">20dp</item>
    </style>

    <style name="SecondaryActivityTheme" parent="Theme.PLAcreator">
        <!-- Autres attributs de style personnalisés ici -->
        <item name="android:colorButtonNormal">#FFFFFF</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:buttonCornerRadius">10dp</item>
    </style>

    <style name="SplashTheme.NoStatusBar" parent="Theme.PLAcreator">
        <!-- Masquer la barre d'action (ActionBar) -->
        <item name="windowActionBar">false</item>
        <!-- Afficher l'activité en mode plein écran -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:textColor">@color/rose</item>
    </style>

    <style name="EditTextHint" parent="TextAppearance.AppCompat">
        <item name="colorAccent">@android:color/white</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="android:textSize">20dp</item>
        <item name="colorControlNormal">@color/black</item>
        <item name="colorControlActivated">@color/rose</item>

    </style>

</resources>